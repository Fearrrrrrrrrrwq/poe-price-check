# Konfiguracja Cloudflare Pages.
#
# Pelna instrukcja wdrozenia jest w DEPLOY.md - tutaj tylko to, co czyta
# wrangler.
#
# UWAGA na srodowiska: "wrangler pages deploy" nie ma flagi --env. Pages sam
# rozstrzyga, czy to produkcja, czy podglad, na podstawie galezi. Powiazania
# z poziomu glownego dotycza produkcji, a podglad musi miec wlasna sekcje
# [env.preview] - bez niej wdrozenie z galezi bocznej ruszy BEZ bazy i wywali
# sie dopiero przy pierwszym zapytaniu.

name = "poe-price-check"
compatibility_date = "2026-01-01"
pages_build_output_dir = "dist"

# --- produkcja --------------------------------------------------------------

[[d1_databases]]
binding = "DB"
database_name = "poe-price-check"
database_id = "WKLEJ-ID-Z-wrangler-d1-create"

# --- podglad (wdrozenia z galezi innych niz glowna) --------------------------
#
# Domyslnie wskazuje na te sama baze, co produkcja. Jesli zaczniesz wdrazac
# z galezi roboczych, zaloz osobna baze i podmien tu identyfikator - inaczej
# testy beda dopisywac sygnaly do prawdziwych statystyk.

[env.preview]

[[env.preview.d1_databases]]
binding = "DB"
database_name = "poe-price-check"
database_id = "WKLEJ-ID-Z-wrangler-d1-create"
